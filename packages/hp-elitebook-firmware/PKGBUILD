pkgname=oma-snap-firmware-hp
pkgver=7700.1
pkgrel=1
pkgdesc='HP EliteBook Ultra G1q GPU and DSP firmware for local hardware testing'
arch=('any')
url='https://ftp.hp.com/pub/softpaq/sp162501-163000/sp162865.cva'
license=('custom:HP-Qualcomm')
depends=('oma-snap-firmware-ubuntu=20260319.217ca6e4-2')
options=('!strip' '!debug')
package() {
  local input=/output/hp-firmware-audit/extracted/src/Driver
  local fw="$pkgdir/usr/lib/firmware/7.0.0-31-generic/qcom/x1e80100/hp/elitebook-ultra-g1q"
  install -Dm644 "$input/qcdx8380/qcdxkmsuc8380.mbn" "$fw/qcdxkmsuc8380.mbn"
  for name in qcadsp8380.mbn adsp_dtbs.elf; do
    install -Dm644 "$input/1ADSP_7700_0711_hamoa/$name" "$fw/$name"
  done
  for name in qccdsp8380.mbn cdsp_dtbs.elf; do
    install -Dm644 "$input/1qcnspmcdm_ext_cdsp8380_7800/$name" "$fw/$name"
  done
  install -Dm644 "$startdir/sp162865.cva" "$pkgdir/usr/share/doc/$pkgname/sp162865.cva"
  install -Dm644 "$startdir/PROVENANCE.txt" "$pkgdir/usr/share/doc/$pkgname/PROVENANCE.txt"
}
