diff --git i/install/user/hardware/lenovo/t14s-trackpoint.sh w/install/user/hardware/lenovo/t14s-trackpoint.sh
new file mode 100644
index 0000000..e1ed1f1
--- /dev/null
+++ w/install/user/hardware/lenovo/t14s-trackpoint.sh
@@ -0,0 +1,24 @@
+# User-authorized workaround for this project's affected LCD ThinkPad.
+# Right/middle button transitions and the suspected EC fault remain unresolved.
+if [[ $(uname -m) == "aarch64" ]] && omarchy-hw-match '^21N10000US$'; then
+  trackpoint_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/input.lua"
+  if ! grep -qF -- '-- BEGIN oma-snap TrackPoint workaround' "$trackpoint_config" 2>/dev/null; then
+    mkdir -p "$(dirname "$trackpoint_config")"
+    if [[ -f $trackpoint_config && ! -e $trackpoint_config.bak.oma-snap-trackpoint ]]; then
+      cp -p "$trackpoint_config" "$trackpoint_config.bak.oma-snap-trackpoint"
+    fi
+    cat >> "$trackpoint_config" <<'LUA'
+
+-- BEGIN oma-snap TrackPoint workaround
+-- Disable stuck-button scrolling on this mouse only; touchpad is unaffected.
+-- Physical right/middle button problems remain unresolved.
+hl.device({
+  name = "hid-over-i2c-04f3:000d-mouse",
+  scroll_method = "no_scroll",
+  scroll_button_lock = false,
+})
+-- END oma-snap TrackPoint workaround
+LUA
+  fi
+  unset trackpoint_config
+fi
