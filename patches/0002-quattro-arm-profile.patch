diff --git i/test/shell.d/snapdragon-recovery-test.sh w/test/shell.d/snapdragon-recovery-test.sh
new file mode 100644
index 0000000..1cf2d06
--- /dev/null
+++ w/test/shell.d/snapdragon-recovery-test.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -euo pipefail
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+test_tmp=$(mktemp -d)
+trap 'rm -rf "$test_tmp"' EXIT
+mkdir "$test_tmp/bin"
+cat >"$test_tmp/bin/oma-snap-boot-install" <<'STUB'
+#!/bin/bash
+exit 99
+STUB
+cat >"$test_tmp/bin/snapper" <<'STUB'
+#!/bin/bash
+exit 99
+STUB
+cat >"$test_tmp/bin/sudo" <<'STUB'
+#!/bin/bash
+echo unexpected-sudo >&2
+exit 99
+STUB
+chmod +x "$test_tmp/bin/"*
+
+# Both paths must stop before escalation, prompting, or boot/disk mutations.
+for command in omarchy-system-factory-reset omarchy-snapshot; do
+  status=0
+  output=$(PATH="$test_tmp/bin:$ROOT/bin:$PATH" bash "$ROOT/bin/$command" restore 2>&1) || status=$?
+  (( status == 1 )) || fail "$command rejects unsupported recovery" "$output"
+  [[ $output == *"not supported by this Snapdragon MVP boot profile"* ]] ||
+    fail "$command explains the unsupported boot profile" "$output"
+  [[ $output != *unexpected-sudo* ]] || fail "$command stops before elevation"
+  pass "$command stops unsupported Snapdragon recovery before mutations"
+done
