diff --git i/bin/omarchy-hw-platform w/bin/omarchy-hw-platform
index 0d0c8dd..f915761 100755
--- i/bin/omarchy-hw-platform
+++ w/bin/omarchy-hw-platform
@@ -1,6 +1,6 @@
 #!/bin/bash
 
-# omarchy:summary=Print the hardware platform Omarchy is running on (apple-silicon, raspberry-pi-5, raspberry-pi, generic-aarch64 or x86_64).
+# omarchy:summary=Print the hardware platform Omarchy is running on.
 # omarchy:examples=omarchy hw platform
 
 # Detection reads the flattened device tree, which is where every aarch64
@@ -23,6 +23,10 @@ model=""
 [[ -r $devicetree/model ]] && model=$(tr -d '\0' <"$devicetree/model")
 
 case "$compatible " in
+  *"lenovo,thinkpad-t14s-lcd "*)
+    echo "snapdragon-t14s-lcd"
+    exit 0
+    ;;
   *"apple,arm-platform "*)
     echo "apple-silicon"
     exit 0
