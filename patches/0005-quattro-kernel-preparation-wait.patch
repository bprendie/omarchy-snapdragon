diff --git a/bin/omarchy-update-snapdragon-kernel b/bin/omarchy-update-snapdragon-kernel
new file mode 100755
--- /dev/null
+++ b/bin/omarchy-update-snapdragon-kernel
@@ -0,0 +1,7 @@
+#!/bin/bash
+# Wait between update phases that can change kernel packages.
+set -euo pipefail
+command -v oma-snap-kernel-queue >/dev/null || exit 0
+sudo systemctl start --wait oma-snap-kernel-prepare.service
+sudo oma-snap-kernel-queue --check-provider-prepared
+sudo oma-snap-boot-publish --activate-provider --wait-lock=30m
