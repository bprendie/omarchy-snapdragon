diff --git i/test/unit/test_snapdragon_boot.py w/test/unit/test_snapdragon_boot.py
new file mode 100644
index 0000000..5e18977
--- /dev/null
+++ w/test/unit/test_snapdragon_boot.py
@@ -0,0 +1,67 @@
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from .test_provisioning_state import make_ctx, phases_impl
+
+
+class SnapdragonBootTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.target = Path(self.tmp.name)
+        self.ctx = make_ctx(
+            self.target,
+            defer_provisioning=False,
+            is_protected=True,
+            user_configuration={"kernels": ["oma-snap-kernel-ubuntu"]},
+            omarchy_install={"boot": {"esp_mount": "/boot", "enable_fallback": False}},
+        )
+        self.kernel = "oma-snap/7.0.0-31-generic/vmlinuz.efi"
+        for name in [self.kernel, "oma-snap/7.0.0-31-generic/initramfs.img", "oma-snap/grub/grub.cfg", "EFI/oma-snap/grubaa64.efi"]:
+            path = self.target / "boot" / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(b"fixture payload")
+        original = self.target / "usr/lib" / self.kernel
+        original.parent.mkdir(parents=True, exist_ok=True)
+        original.write_bytes(b"fixture payload")
+
+    def test_preserved_esp_does_not_request_fallback_overwrite(self):
+        with mock.patch.object(phases_impl.subprocess, "run") as run:
+            phases_impl.finalize_limine_boot(self.ctx)
+        self.assertNotIn("--fallback", run.call_args.args[0])
+        self.assertEqual(run.call_args.args[0][0], str(self.target / "usr/bin/oma-snap-boot-install"))
+
+    def test_boot_payload_validation_accepts_matching_kernel(self):
+        phases_impl.validate_boot(self.ctx)
+
+    def test_modified_stubble_image_is_rejected(self):
+        (self.target / "boot" / self.kernel).write_bytes(b"modified")
+        with self.assertRaisesRegex(RuntimeError, "differs from the packaged"):
+            phases_impl.validate_boot(self.ctx)
+
+    def test_missing_packaged_kernel_is_rejected(self):
+        (self.target / "usr/lib" / self.kernel).unlink()
+        with self.assertRaisesRegex(RuntimeError, "exactly one packaged"):
+            phases_impl.validate_boot(self.ctx)
+
+    def test_ambiguous_packaged_kernels_are_rejected(self):
+        older = self.target / "usr/lib/oma-snap/7.0.0-30-generic/vmlinuz.efi"
+        older.parent.mkdir(parents=True)
+        older.write_bytes(b"older kernel")
+        with self.assertRaisesRegex(RuntimeError, "exactly one packaged"):
+            phases_impl.validate_boot(self.ctx)
+
+    def test_requested_fallback_must_exist(self):
+        self.ctx.omarchy_install["boot"]["enable_fallback"] = True
+        with self.assertRaisesRegex(RuntimeError, "Removable Snapdragon bootloader"):
+            phases_impl.validate_boot(self.ctx)
+
+    def test_unsupported_encrypted_deferred_mode_fails_before_disk_work(self):
+        self.ctx.defer_provisioning = True
+        self.ctx.encrypt = True
+        with mock.patch.object(phases_impl.subprocess, "run") as run:
+            with self.assertRaisesRegex(RuntimeError, "Encrypted deferred provisioning"):
+                phases_impl.prepare_live(self.ctx)
+            run.assert_not_called()
