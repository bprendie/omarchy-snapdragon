#!/bin/busybox sh
# PID 1 for a narrow ARM boot test, not an Omarchy installation substitute.
exec >/dev/ttyAMA0 2>&1
B=/bin/busybox
fail() {
  echo "OMA_SET_BOOT_FAIL: $*"
  $B sync
  $B poweroff -f
  while :; do $B sleep 60; done
}
[ -r /proc/self/mountinfo ] || fail 'initramfs did not preserve proc mount'
{
  read -r expected_set
  read -r expected_release
  read -r expected_entry
} < /etc/oma-test-expected
[ "$($B uname -r)" = "$expected_release" ] || fail 'kernel mismatch'
[ "$($B cat /run/oma-snap/booted-set)" = "$expected_set" ] || fail 'hardware identity'
[ "$($B cat /run/oma-snap/booted-entry)" = "$expected_entry" ] || fail 'boot identity'
$B touch /root-write-test || fail 'test root is not writable'
for kind in modules firmware; do
  target=/usr/lib/$kind/$expected_release
  options=$($B awk -v path="$target" '$5 == path {print $6}' /proc/self/mountinfo)
  case ",$options," in *,ro,*) ;; *) fail "$kind not mounted read-only";; esac
  if (echo changed > "$target/should-not-write") 2>/dev/null; then fail "$kind permits writes"; fi
done
[ -s /usr/lib/modules/$expected_release/modules.dep.bin ] || fail 'module indexes absent'
for model in LENOVO/21N1 hp/elitebook-ultra-g1q ASUSTeK/zenbook-a14; do
  [ -s /usr/lib/firmware/$expected_release/qcom/x1e80100/$model/qccdsp8380.mbn ] || fail "firmware $model"
done
echo "OMA_SET_BOOT_PASS: $expected_set $expected_entry"
$B sync
$B poweroff -f
while :; do $B sleep 60; done
